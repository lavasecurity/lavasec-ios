    "The selected filter keeps its name. Review the content changes below.": {
      "comment": "Filter review, sharing or import. Keep user filter names verbatim. Review is read-only; confirmation saves the displayed changes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected filter keeps its name. Review the content changes below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフィルターの名前は変わりません。以下の内容変更を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選篩選器的名稱保持不變。請檢閱下方的內容變更。"
