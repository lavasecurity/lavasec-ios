    "Encrypted on this device. Only you can unlock your backup.": {
      "comment": "Shared native task-sheet copy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted on this device. Only you can unlock your backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで暗号化されます。バックアップを解除できるのはあなただけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上加密。只有你能解锁备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台裝置上加密。只有你能解鎖備份。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 암호화됩니다. 본인만 백업을 잠금 해제할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffrée sur cet appareil. Vous seul pouvez déverrouiller votre sauvegarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät verschlüsselt. Nur du kannst dein Backup entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrada en este dispositivo. Solo tú puedes desbloquear tu copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografado neste dispositivo. Só você pode desbloquear seu backup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crittografato su questo dispositivo. Solo tu puoi sbloccare il backup."
          }
        }
      }
    },
    "Unlock your backup, review its changes, then restore.": {
      "comment": "Shared native task-sheet copy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your backup, review its changes, then restore."
