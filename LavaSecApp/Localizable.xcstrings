          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 필터를 저장하거나 복원하지 못했어요. 다시 시도하기 전에 사용 중인 필터를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
