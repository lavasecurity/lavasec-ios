    "Something phishy? Swim away.": {
      "comment": "GuardianShieldStyle.settingsDescription .aquamarine. Playful fish/phishing pun; adapt the wordplay naturally while keeping the advice to avoid suspicious messages.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas faul? Schwimm davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something phishy? Swim away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te quieren pescar? ¡Nada y escapa!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On t’hameçonne ? Prends le large."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti vogliono pescare? Nuota via."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィッシング？ スイスイ逃げよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낚시 냄새가 나면? 헤엄쳐 도망가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pescaram? Nade para longe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到钓鱼？快游开！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到釣魚？快游開！"
          }
        }
      }
    },
    "If a message rushes you to click, pause. Open the official app or website yourself.": {
      "comment": "GuardianShieldStyle.settingsTip .aquamarine. Practical anti-phishing habit shown beneath the Guard quote. Catalog-only.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dich eine Nachricht zum schnellen Klicken drängt, halte kurz inne. Öffne die offizielle App oder Website selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a message rushes you to click, pause. Open the official app or website yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un mensaje te mete prisa para hacer clic, detente. Abre tú mismo la app o el sitio web oficial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un message te pousse à cliquer vite, fais une pause. Ouvre toi-même l’app ou le site officiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un messaggio ti mette fretta di fare clic, fermati. Apri tu l’app o il sito ufficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックを急かすメッセージが来たら、ひと呼吸。公式アプリや公式サイトを自分で開きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 서둘러 클릭하라고 재촉하면 잠시 멈추세요. 공식 앱이나 사이트를 직접 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se uma mensagem te pressiona a clicar, pare um instante. Abra o app ou site oficial por conta própria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果消息催促你轻点，先停一下。请自行打开官方 App 或网站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果訊息催促你點選，先停一下。請自行開啟官方 App 或網站。"
          }
        }
      }
    },
