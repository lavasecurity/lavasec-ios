    "Lava tries the primary DNS first, then the fallback DNS if needed.": {
      "comment": "User-visible: RN screen (runtime sweep)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava tries the primary DNS first, then the fallback DNS if needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava versucht zuerst das primäre DNS und bei Bedarf dann das Ersatz-DNS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava prueba primero el DNS principal y, si hace falta, el DNS de respaldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava essaie d’abord le DNS principal, puis le DNS de secours si nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava prova prima il DNS primario, poi il DNS di riserva se serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LavaはまずプライマリDNSを使い、必要に応じてフォールバックDNSを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava는 먼저 기본 DNS를 시도하고, 필요하면 대체 DNS를 사용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lava tenta primeiro o DNS primário e, se necessário, o DNS alternativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava 会先尝试主 DNS，必要时再使用备用 DNS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava 會先嘗試主要 DNS，必要時再使用備援 DNS。"
          }
        }
      }
    },
    "This profile handles system DNS requests and helps Lava filter with Connectivity Assist.": {
      "comment": "User-visible: RN screen (runtime sweep)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile handles system DNS requests and helps Lava filter with Connectivity Assist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil verarbeitet System-DNS-Anfragen und hilft Lava, auch bei aktiver „Verbindungshilfe“ zu filtern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil gestiona las solicitudes DNS del sistema y ayuda a Lava a filtrar cuando Asistencia de conectividad está activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil traite les requêtes DNS du système et aide Lava à filtrer quand l’Assistance à la connectivité est active."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo gestisce le richieste DNS di sistema e aiuta Lava a filtrare quando Assistenza connettività è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルはシステムのDNSリクエストを処理し、接続アシストの使用中もLavaがフィルタリングできるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로파일은 시스템 DNS 요청을 처리하고, 연결 지원이 켜져 있어도 Lava가 필터링할 수 있게 해 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil processa as solicitações DNS do sistema e ajuda o Lava a filtrar quando a Assistência de Conectividade está ativada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此描述文件负责处理系统 DNS 请求，并帮助 Lava 在“连接助理”开启时进行筛选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此描述檔負責處理系統 DNS 請求，並協助 Lava 在「連線輔助」開啟時進行篩選。"
          }
        }
      }
    },
