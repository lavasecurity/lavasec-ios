            "state": "translated",
            "value": "許可されたDNSリクエストはVPN経由で送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN이 허용된 DNS 요청을 전달해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua VPN leva as solicitações DNS permitidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 VPN 会传送允许的 DNS 请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 VPN 會傳送允許的 DNS 請求。"
          }
        }
      }
    },
    "With VPN chaining off, allowed DNS requests go straight to DNS.": {
      "comment": "React Native v2 interface. Preserve placeholders and product names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With VPN chaining off, allowed DNS requests go straight to DNS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ausgeschalteter VPN-Verkettung gehen erlaubte DNS-Anfragen direkt zum DNS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el encadenamiento VPN desactivado, las solicitudes DNS permitidas van directamente al DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le chaînage VPN est désactivé, les requêtes DNS autorisées vont directement au DNS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il concatenamento VPN disattivato, le richieste DNS consentite vanno direttamente al DNS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNチェーンがオフのとき、許可されたDNSリクエストは直接DNSへ向かいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 체이닝이 꺼져 있으면 허용된 DNS 요청이 DNS로 바로 가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o encadeamento de VPN desativado, as solicitações DNS permitidas vão direto ao DNS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 串联关闭时，允许的 DNS 请求会直接送往 DNS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 串接關閉時，允許的 DNS 請求會直接送往 DNS。"
          }
        }
      }
    },
    "VPN chaining can send allowed DNS requests through your own VPN.": {
      "comment": "React Native v2 interface. Preserve placeholders and product names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN chaining can send allowed DNS requests through your own VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die VPN-Verkettung kann erlaubte DNS-Anfragen über dein eigenes VPN leiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El encadenamiento VPN puede enviar las solicitudes DNS permitidas a través de tu propia VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chaînage VPN peut faire passer les requêtes DNS autorisées par votre propre VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il concatenamento VPN può inviare le richieste DNS consentite attraverso la tua VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNチェーンを使うと、許可されたDNSリクエストを自分のVPN経由で送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 체이닝을 사용하면 허용된 DNS 요청을 내 VPN으로 보낼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O encadeamento de VPN pode enviar as solicitações DNS permitidas pela sua própria VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 串联可以让允许的 DNS 请求经过你自己的 VPN。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
