    "Use Lava without an account, or sign in to back up your settings securely.": {
      "comment": "Shared interface copy. Preserve product names and technical abbreviations.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Lava without an account, or sign in to back up your settings securely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Lava ohne Konto oder melde dich an, um deine Einstellungen sicher zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Lava sin cuenta o inicia sesión para guardar tus ajustes de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Lava sans compte, ou connectez-vous pour sauvegarder vos réglages en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Lava senza account o accedi per salvare le impostazioni in modo sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしで Lava を使えます。設定を安全にバックアップするにはサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없이 Lava를 사용하거나 로그인하여 설정을 안전하게 백업하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Lava sem conta ou entre para fazer um backup seguro das suas configurações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户即可使用 Lava，也可登录以安全备份设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需帳號即可使用 Lava，也可登入以安全備份設定。"
          }
        }
      }
    },
    "Connection and protection events stay on this device for 7 days. Share them only when you choose to attach a bug report.": {
      "comment": "Shared interface copy. Preserve product names and technical abbreviations.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection and protection events stay on this device for 7 days. They leave it only if you include diagnostics when you send feedback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungs- und Schutzereignisse bleiben 7 Tage auf diesem Gerät. Sie verlassen es nur, wenn du beim Senden von Feedback Diagnosedaten beifügst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos de conexión y protección se guardan en este dispositivo durante 7 días. Solo salen de él si incluyes los diagnósticos al enviar comentarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements de connexion et de protection restent 7 jours sur cet appareil. Ils n’en sortent que si vous joignez les diagnostics à votre retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi di connessione e protezione restano su questo dispositivo per 7 giorni. Escono dal dispositivo solo se includi la diagnostica quando invii un feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続と保護のイベントはこのデバイスに7日間保存されます。フィードバックの送信時に診断を含めた場合にのみ、デバイスの外に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 및 보호 이벤트는 이 기기에 7일 동안 보관돼요. 의견을 보낼 때 진단 정보를 포함한 경우에만 기기 밖으로 전송돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os eventos de conexão e proteção ficam neste dispositivo por 7 dias. Eles só saem dele se você incluir os diagnósticos ao enviar feedback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接与防护事件会在此设备上保留 7 天。只有在你发送反馈时选择附带诊断信息，它们才会离开此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線與防護事件會在這台裝置上保留 7 天。只有在你傳送意見回饋時選擇附上診斷資料，它們才會離開這台裝置。"
          }
        }
      }
    },
