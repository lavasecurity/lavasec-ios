    "First, let’s get Lava ready to help.": {
      "comment": "Warm onboarding heading above the VPN and optional notification setup rows. Setup prepares Lava; it does not start protection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First, let’s get Lava ready to help."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは、Lavaがあなたを守る準備をしましょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen wir Lava zuerst bereit, dir zu helfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commençons par préparer Lava à vous aider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero, preparemos Lava para ayudarte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Lava가 도울 수 있도록 준비해 볼까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, vamos preparar o Lava para ajudar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per prima cosa, prepariamo Lava ad aiutarti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首先，让 Lava 做好帮助你的准备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首先，讓 Lava 做好幫助你的準備。"
          }
        }
      }
    },
    "Lastly, let’s keep your connection running smoothly.": {
      "comment": "Onboarding connection options: conversational heading or quiet explanation outside its toggle card. Preserve service and Apple feature names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lastly, let’s keep your connection running smoothly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に、スムーズな接続のための設定をしましょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgen wir zum Schluss für eine reibungslose Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfin, gardons votre connexion fluide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por último, hagamos que tu conexión funcione sin problemas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로, 연결이 원활하도록 설정해 볼까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
