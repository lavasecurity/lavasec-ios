      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes unearned Lava Guard progress from this device. Earned Lava Guards stay unlocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird noch nicht freigeschalteter Lava-Guard-Fortschritt von diesem Gerät entfernt. Bereits verdiente Lava Guards bleiben freigeschaltet."
