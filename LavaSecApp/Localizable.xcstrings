          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IP verwendet standardmäßiges, unverschlüsseltes DNS. DoH (DNS over HTTPS), DoT (DNS over TLS) und DoQ (DNS over QUIC) verschlüsseln Anfragen zwischen Lava und deinem DNS-Anbieter."
          }
