    },
    "This changes the filter protecting this device. “%@” keeps its name and receives the reviewed content.": {
      "comment": "Filter review, sharing or import. Keep user filter names verbatim. Review is read-only; confirmation saves the displayed changes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes your active filter. “%@” keeps its name and receives the reviewed content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のフィルターが変更されます。「%@」の名前は変わらず、確認した内容に置き換わります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會變更你使用中的篩選器。「%@」的名稱保持不變，並套用已檢閱的內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会更改你正在使用的筛选器。“%@”的名称保持不变，并应用已检查的内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ändert deinen aktiven Filter. „%@“ behält seinen Namen und erhält den geprüften Inhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela modifie votre filtre actif. « %@ » garde son nom et reçoit le contenu vérifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cambia tu filtro activo. «%@» conserva su nombre y recibe el contenido revisado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 필터가 변경돼요. “%@”의 이름은 유지되고 검토한 내용이 적용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso altera o seu filtro ativo. “%@” mantém o nome e recebe o conteúdo revisado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modifica il tuo filtro attivo. «%@» mantiene il nome e riceve il contenuto verificato."
          }
        }
      }
    },
