    "With fallback off, VPN chaining uses DNS from its WireGuard configuration.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With fallback off, VPN chaining uses DNS from its WireGuard configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォールバックがオフのとき、VPNチェーンはWireGuard構成のDNSを使います。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 備援關閉時，VPN 串接會使用 WireGuard 設定中的 DNS。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 备用关闭时，VPN 串联会使用 WireGuard 配置中的 DNS。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ausgeschaltetem DNS-Ersatz nutzt die VPN-Verkettung das DNS aus ihrer WireGuard-Konfiguration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le DNS de secours est désactivé, le chaînage VPN utilise le DNS de sa configuration WireGuard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el respaldo desactivado, el encadenamiento VPN usa el DNS de su configuración de WireGuard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 대체가 꺼져 있으면 VPN 체이닝은 WireGuard 구성의 DNS를 사용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o DNS alternativo desativado, o encadeamento de VPN usa o DNS da configuração do WireGuard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il DNS di riserva disattivato, il concatenamento VPN usa quello della sua configurazione WireGuard."
          }
        }
      },
      "comment": "Round 7 interface refinement. Settings or filter label. Preserve product names Lava Plus and WireGuard; fallback means alternate DNS resolvers when permitted."
    },
    "Open Auto-switch filters": {
      "extractionState": "manual",
      "localizations": {
