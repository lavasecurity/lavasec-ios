          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解若失去所有解鎖方式，可能就無法復原備份"
          }
        }
      }
    },
    "IP uses standard DNS. DNS over HTTPS (DoH), TLS (DoT), and QUIC (DoQ) encrypt allowed lookups to the resolver.": {
      "comment": "Detail under the DNS Transport segmented control.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IP uses standard, unencrypted DNS. DoH (DNS over HTTPS), DoT (DNS over TLS), and DoQ (DNS over QUIC) encrypt requests between Lava and your DNS provider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IP verwendet standardmäßiges, unverschlüsseltes DNS. DoH (DNS over HTTPS), DoT (DNS over TLS) und DoQ (DNS over QUIC) verschlüsseln Anfragen zwischen Lava und deinem DNS-Anbieter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IP usa DNS estándar sin cifrar. DoH (DNS over HTTPS), DoT (DNS over TLS) y DoQ (DNS over QUIC) cifran las solicitudes entre Lava y tu proveedor de DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IP utilise le DNS standard, non chiffré. DoH (DNS over HTTPS), DoT (DNS over TLS) et DoQ (DNS over QUIC) chiffrent les requêtes entre Lava et votre fournisseur DNS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IP usa il DNS standard non cifrato. DoH (DNS over HTTPS), DoT (DNS over TLS) e DoQ (DNS over QUIC) cifrano le richieste tra Lava e il tuo provider DNS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPは標準の暗号化されていないDNSを使用します。DoH（DNS over HTTPS）、DoT（DNS over TLS）、DoQ（DNS over QUIC）は、LavaとDNSプロバイダー間のリクエストを暗号化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IP는 암호화되지 않은 표준 DNS를 사용해요. DoH(DNS over HTTPS), DoT(DNS over TLS), DoQ(DNS over QUIC)는 Lava와 DNS 공급자 사이의 요청을 암호화해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O IP usa DNS padrão, sem criptografia. DoH (DNS over HTTPS), DoT (DNS over TLS) e DoQ (DNS over QUIC) criptografam as solicitações entre o Lava e seu provedor de DNS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 使用标准的未加密 DNS。DoH（DNS over HTTPS）、DoT（DNS over TLS）和 DoQ（DNS over QUIC）会加密 Lava 与你的 DNS 提供商之间的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 使用標準的未加密 DNS。DoH（DNS over HTTPS）、DoT（DNS over TLS）和 DoQ（DNS over QUIC）會加密 Lava 與你的 DNS 供應商之間的請求。"
          }
        }
      }
    },
