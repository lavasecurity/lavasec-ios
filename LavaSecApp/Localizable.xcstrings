    "Only counts are included, so support can tell whether protection is seeing traffic without receiving browsing history.": {
      "comment": "Bug-report preview section title/purpose (BugReportBundle, shown via .lavaLocalized).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only counts are included, so support can tell whether protection is seeing requests without receiving browsing history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Zähler einbezogen, damit der Support sehen kann, ob der Schutz Anfragen erkennt – ohne deinen Browserverlauf zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se incluyen recuentos, para que el soporte pueda saber si la protección ve solicitudes sin recibir tu historial de navegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls des décomptes sont inclus, afin que l’assistance puisse voir si la protection détecte des requêtes sans recevoir votre historique de navigation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono inclusi solo i conteggi, così il supporto può capire se la protezione rileva richieste senza ricevere la cronologia di navigazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "件数のみが含まれるため、サポートは閲覧履歴を受け取らずに、保護がリクエストを検知しているかを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "횟수만 포함되므로, 지원팀은 검색 기록을 받지 않고도 보호가 요청을 감지하는지 확인할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as contagens são incluídas, para que o suporte possa saber se a proteção está detectando solicitações sem receber seu histórico de navegação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含计数，因此支持人员无需获取你的浏览记录即可判断防护是否收到请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅包含計數，因此支援人員無需取得你的瀏覽記錄即可判斷防護是否收到請求。"
          }
        }
      }
    },
