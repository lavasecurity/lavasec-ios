            "value": "As alterações pendentes da biblioteca não serão aplicadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche in bozza alla raccolta non verranno applicate."
          }
        }
      }
    },
    "Your filter is shared as-is. Review your blocklists, blocked sites, and allowed exceptions before sharing. Anyone with the code can see them.": {
      "comment": "One-paragraph disclosure in the green shared-filter information panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your filter is shared as-is. Review your blocklists, blocked domains, and allowed exceptions before sharing. Anyone with the setup code can see them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターはそのまま共有されます。共有前に、ブロックリスト、ブロックするドメイン、許可する例外を確認してください。セットアップコードを持つ人は誰でも内容を確認できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的篩選器將原樣分享。分享前，請檢閱你的封鎖清單、已封鎖的網域及允許的例外。任何持有設定代碼的人都能看到這些內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的筛选器将原样分享。分享前，请检查你的拦截列表、已拦截的域名和允许的例外。任何持有设置代码的人都能看到这些内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Filter wird unverändert geteilt. Prüfe vor dem Teilen deine Blocklisten, blockierten Domains und erlaubten Ausnahmen. Jeder mit dem Einrichtungscode kann sie sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre filtre est partagé tel quel. Avant de partager, vérifiez vos listes de blocage, domaines bloqués et exceptions autorisées. Toute personne disposant du code de configuration peut les voir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu filtro se comparte tal cual. Antes de compartir, revisa tus listas de bloqueo, dominios bloqueados y excepciones permitidas. Cualquiera con el código de configuración puede verlos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터가 그대로 공유돼요. 공유하기 전에 차단 목록, 차단 도메인, 허용 예외를 검토하세요. 설정 코드가 있는 사람은 누구나 볼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu filtro é compartilhado como está. Antes de compartilhar, revise suas listas de bloqueio, domínios bloqueados e exceções permitidas. Qualquer pessoa com o código de configuração pode vê-los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo filtro viene condiviso così com’è. Prima di condividere, controlla le liste di blocco, i domini bloccati e le eccezioni consentite. Chiunque abbia il codice di configurazione può vederli."
          }
        }
      }
    },
    "Your filters changed or could not be saved. Close Review and check your changes before trying again.": {
      "comment": "Filter review, sharing or import. Keep user filter names verbatim. Review is read-only; confirmation saves the displayed changes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your filters changed or couldn’t be saved. Close Review and check your changes before trying again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターが変更されたか、保存できませんでした。確認画面を閉じて変更内容を確認し、再試行してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "篩選器已變更或無法儲存。請關閉檢閱畫面，確認變更後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选器已更改或无法保存。请关闭检查页面，确认更改后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Filter wurden geändert oder konnten nicht gespeichert werden. Schließe die Prüfung und kontrolliere deine Änderungen vor einem erneuten Versuch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos filtres ont changé ou n’ont pas pu être enregistrés. Fermez la vérification et contrôlez vos modifications avant de réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus filtros cambiaron o no se pudieron guardar. Cierra la revisión y comprueba los cambios antes de reintentarlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터가 변경되었거나 저장하지 못했습니다. 검토를 닫고 변경 사항을 확인한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus filtros mudaram ou não puderam ser salvos. Feche a revisão e confira as alterações antes de tentar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I filtri sono cambiati o non sono stati salvati. Chiudi la revisione e controlla le modifiche prima di riprovare."
          }
        }
      }
    },
