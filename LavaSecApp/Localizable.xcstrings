    "Hey I'm no rock but I take security paw-sonally. U know what I mean?": {
      "comment": "GuardianShieldStyle.settingsDescription .kiwiCreme (SettingsView:2122). Catalog-only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, I’m no rock, but I take security paw-sonally. You know what I mean?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, ich bin kein Stein, aber ich nehme Sicherheit ziemlich pföttlich. Du weißt, was ich meine?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oye, no soy una roca, pero la seguridad me la tomo a la pata de la letra. ¿Me captas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne suis pas un caillou, mais la sécurité, je la prends à la patte. Tu vois le genre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehi, non sono mica una roccia, ma la sicurezza me la prendo a zampe pari. Mi spiego?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ねえ、ただの石じゃないよ。セキュリティは肉球かけて本気だから。わかるよね？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 돌멩이는 아니지만 보안은 발바닥까지 진심이라구. 무슨 말인지 알지?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei, não sou só uma pedra, mas levo a segurança a sério na pata. Saca a ideia?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿，我可不是块石头，但我对安全可是一丝不“狗”。懂我意思吧？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿，我可不是塊石頭，但我對安全可是一絲不「狗」。懂我意思吧？"
          }
        }
      }
    },
