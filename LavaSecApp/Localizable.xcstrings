          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma configuração do WireGuard em Encadeamento de VPN ou desative o encadeamento de VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una configurazione WireGuard in Concatenamento VPN oppure disattiva il concatenamento VPN."
          }
        }
      },
      "comment": "Guard start recovery when chaining is enabled but no configuration exists. VPN chaining names the Settings page."
    },
    "Your WireGuard key is missing. Load the configuration again, or turn chaining off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your WireGuard key is missing. Load the configuration again, or turn VPN chaining off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein WireGuard-Schlüssel fehlt. Lade die Konfiguration erneut oder schalte die VPN-Verkettung aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé WireGuard est manquante. Rechargez la configuration ou désactivez le chaînage VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuardキーがありません。構成を再読み込みするか、VPNチェーンをオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard 密钥缺失。请重新加载配置，或关闭 VPN 串联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard 金鑰遺失。請重新載入設定，或關閉 VPN 串接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta tu clave de WireGuard. Vuelve a cargar la configuración o desactiva el encadenamiento VPN."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard 키가 없어요. 구성을 다시 불러오거나 VPN 체이닝을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave do WireGuard está ausente. Carregue a configuração novamente ou desative o encadeamento de VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca la tua chiave WireGuard. Carica di nuovo la configurazione oppure disattiva il concatenamento VPN."
          }
        }
      },
      "comment": "Guard recovery when a saved configuration exists but its device-bound private key is absent. Never display the key itself."
    },
    "The saved configuration and its keys will be deleted, and VPN chaining will turn off. Guard reconnects if it is on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved configuration and its keys will be deleted, and VPN chaining will turn off. Protection reconnects if it’s on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Konfiguration und ihre Schlüssel werden gelöscht und die VPN-Verkettung wird ausgeschaltet. Der Schutz verbindet sich neu, wenn er eingeschaltet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration enregistrée et ses clés seront supprimées, et le chaînage VPN sera désactivé. La protection se reconnecte si elle est activée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された構成とキーが削除され、VPNチェーンがオフになります。保護がオンの場合は再接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的配置及其密钥将被删除，VPN 串联将关闭。如果防护已开启，它会重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的設定及其金鑰將被刪除，VPN 串接將關閉。如果防護已開啟，會重新連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán la configuración guardada y sus claves, y se desactivará el encadenamiento VPN. La protección se reconecta si está activada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 구성과 키가 삭제되고 VPN 체이닝이 꺼져요. 보호가 켜져 있으면 다시 연결돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração salva e suas chaves serão excluídas, e o encadeamento de VPN será desativado. A proteção se reconecta se estiver ativada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione salvata e le relative chiavi verranno eliminate e il concatenamento VPN verrà disattivato. La protezione si riconnette se è attivata."
          }
        }
      },
      "comment": "Destructive confirmation in the WireGuard editor. Both credentials are removed, chaining is disabled, and active Guard reconnects."
    },
    "The saved configuration and its keys will be replaced. Guard reconnects if chaining is on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved configuration and its keys will be replaced. Protection reconnects if VPN chaining is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Konfiguration und ihre Schlüssel werden ersetzt. Der Schutz verbindet sich neu, wenn die VPN-Verkettung eingeschaltet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration enregistrée et ses clés seront remplacées. La protection se reconnecte si le chaînage VPN est activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された構成とキーが置き換えられます。VPNチェーンがオンの場合、保護は再接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的配置及其密钥将被替换。如果 VPN 串联已开启，防护会重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的設定及其金鑰將被取代。如果 VPN 串接已開啟，防護會重新連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazarán la configuración guardada y sus claves. La protección se reconecta si el encadenamiento VPN está activado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 구성과 키가 교체돼요. VPN 체이닝이 켜져 있으면 보호가 다시 연결돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração salva e suas chaves serão substituídas. A proteção se reconecta se o encadeamento de VPN estiver ativado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione salvata e le relative chiavi verranno sostituite. La protezione si riconnette se il concatenamento VPN è attivato."
          }
        }
      },
      "comment": "Replacement confirmation in the WireGuard editor. Saving preserves the separate chaining switch and reconnects only when applicable."
    },
    "After saving, your private key stays in this device's Keychain and isn't shown again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Speichern bleibt dein privater Schlüssel im Schlüsselbund dieses Geräts und wird nicht mehr angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After saving, your private key stays in this device’s keychain and isn’t shown again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, tu clave privada se queda en el llavero de este dispositivo y no vuelve a mostrarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’enregistrement, votre clé privée reste dans le trousseau de cet appareil et n’est plus affichée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo il salvataggio, la chiave privata resta nel Portachiavi di questo dispositivo e non viene più mostrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存後、秘密鍵はこのデバイスのキーチェーンに保管され、再表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 후 개인 키는 이 기기의 키체인에 보관되며 다시 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após salvar, sua chave privada fica nas Chaves deste dispositivo e não é exibida novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后，私钥会保留在此设备的钥匙串中，不再显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後，私密金鑰會保留在這台裝置的鑰匙圈中，不再顯示。"
          }
        }
      },
      "comment": "WireGuard editor help. Keychain is Apple's secure credential store. Explains why saved private keys cannot be viewed again.",
      "extractionState": "manual"
    },
    "Change Lava's look and feel. Protection stays the same.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere das Aussehen von Lava. Der Schutz bleibt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Lava’s look and feel. Protection stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el aspecto de Lava. La protección sigue igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnalisez l’apparence de Lava. La protection reste identique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia l’aspetto di Lava. La protezione resta invariata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavaの見た目や使い心地を変更できます。保護機能は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava의 모양과 느낌을 바꿔 보세요. 보호 기능은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude a aparência do Lava. A proteção continua igual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改 Lava 的外观和使用体验，防护保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更 Lava 的外觀和使用體驗，防護保持不變。"
          }
        }
      },
      "comment": "Customization introduction. Appearance and feedback preferences do not change DNS protection.",
      "extractionState": "manual"
    },
    "Detailed activity stays on this device for 7 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Domainverlauf bleibt 7 Tage auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Domain history stays on this device for 7 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de dominios se guarda en este dispositivo durante 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique des domaines reste sur cet appareil pendant 7 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia dei domini resta su questo dispositivo per 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメイン履歴はこのデバイスに7日間保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도메인 기록은 이 기기에 7일 동안 보관돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de domínios fica neste dispositivo por 7 dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "域名历史记录会在此设备上保留 7 天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網域記錄會在這台裝置上保留 7 天。"
          }
        }
      },
      "comment": "Activity and domain-history retention footer. Detailed records are retained locally for seven days.",
      "extractionState": "manual"
    },
    "Domain history and network activity stay on this device for 7 days. Counts and Guard progress last longer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Domainverlauf und Netzwerkaktivität bleiben 7 Tage auf diesem Gerät. Zähler und Lava-Guard-Fortschritt bleiben länger erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Domain history and network activity stay on this device for 7 days. Counts and Lava Guard progress last longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de dominios y la actividad de red se guardan en este dispositivo durante 7 días. Los recuentos y el progreso de Lava Guard duran más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique des domaines et l’activité réseau restent sur cet appareil pendant 7 jours. Les compteurs et la progression Lava Guard sont conservés plus longtemps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia dei domini e l’attività di rete restano su questo dispositivo per 7 giorni. Conteggi e progressi di Lava Guard durano più a lungo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメイン履歴とネットワークアクティビティは、このデバイスに7日間保存されます。件数とLava Guardの進行状況はより長く保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도메인 기록과 네트워크 활동은 이 기기에 7일 동안 보관돼요. 횟수와 Lava Guard 진행 상황은 더 오래 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de domínios e a atividade de rede ficam neste dispositivo por 7 dias. Contagens e progresso do Lava Guard duram mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "域名历史记录和网络活动会在此设备上保留 7 天。计数和 Lava Guard 进度会保留更久。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網域記錄和網路活動會在這台裝置上保留 7 天。計數和 Lava Guard 進度會保留更久。"
          }
        }
      },
      "comment": "Privacy introduction. Detailed history stays on this device for seven days; aggregate counters and Guard progress are retained longer.",
      "extractionState": "manual"
    },
    "Lava filters first, then sends allowed DNS requests through your WireGuard VPN.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava filtert zuerst und sendet erlaubte DNS-Anfragen dann über dein WireGuard-VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava filters first, then sends allowed DNS requests through your WireGuard VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava filtra primero y después envía las solicitudes DNS permitidas por tu VPN WireGuard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava filtre d’abord, puis envoie les requêtes DNS autorisées via votre VPN WireGuard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava filtra prima, poi invia le richieste DNS consentite tramite la tua VPN WireGuard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavaはまずフィルタリングし、許可されたDNSリクエストをWireGuard VPN経由で送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava가 먼저 필터링한 다음 허용된 DNS 요청을 WireGuard VPN으로 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lava filtra primeiro e envia as solicitações DNS permitidas pela sua VPN WireGuard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava 先筛选，再通过你的 WireGuard VPN 发送允许的 DNS 请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava 先篩選，再透過你的 WireGuard VPN 傳送允許的 DNS 請求。"
          }
        }
      },
      "comment": "VPN chaining introduction. Only requests allowed by the local DNS filter are forwarded.",
      "extractionState": "manual"
    },
