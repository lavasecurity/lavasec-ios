    "Allow camera access in Settings to scan a QR code — or tap back and enter the code instead.": {
      "comment": "Localization-gap backfill (was hardcoded in ShareableFiltersUI.swift).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in the Settings app to scan a QR code, or tap Back and enter the code instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kamerazugriff in der App „Einstellungen“, um einen QR-Code zu scannen, oder tippe auf „Zurück“ und gib stattdessen den Code ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara en la app Ajustes para escanear un código QR, o toca Atrás e introduce el código a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à l’appareil photo dans l’app Réglages pour scanner un code QR, ou touchez Retour et saisissez plutôt le code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso alla fotocamera nell’app Impostazioni per scansionare un codice QR, oppure tocca Indietro e inserisci il codice manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを読み取るには「設定」Appでカメラへのアクセスを許可してください。または「戻る」をタップしてコードを直接入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드를 스캔하려면 설정 앱에서 카메라 접근을 허용하세요. 또는 뒤로를 탭하고 코드를 직접 입력해도 돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera no app Ajustes para ler um código QR, ou toque em Voltar e digite o código."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
