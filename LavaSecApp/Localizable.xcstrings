    "Couldn’t check available lists. Try again when you’re online.": {
      "comment": "Shared filter import checks current catalog availability. %@ is the number of skipped lists when present. Existing installations are retained.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbare Listen konnten nicht geprüft werden. Versuche es erneut, wenn du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check available lists. Try again when you’re online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les listes disponibles. Réessayez une fois en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なリストを確認できませんでした。オンラインになってからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查可用列表。请联网后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查可用清單。請連線後再試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron comprobar las listas disponibles. Inténtalo de nuevo cuando tengas conexión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 목록을 확인하지 못했습니다. 온라인 상태에서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar as listas disponíveis. Tente novamente quando estiver online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare le liste disponibili. Riprova quando sei online."
          }
        }
      }
    },
