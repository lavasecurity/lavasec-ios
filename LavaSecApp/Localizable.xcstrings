    "Split-tunnel VPNs only. These lookups leave the VPN tunnel and go to your selected DNS providers.": {
      "comment": "VPN chaining settings and DNS tiers diagnostics.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split-tunnel VPNs only. These lookups leave the VPN tunnel and go to your selected DNS providers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スプリットトンネルVPNのみ。これらの問い合わせはVPNトンネルを出て、選択したDNSプロバイダーに送信されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於分割通道 VPN。這些查詢會離開 VPN 通道，傳送至你選取的 DNS 供應商。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于拆分隧道 VPN。这些查询会离开 VPN 隧道，发送到您选择的 DNS 提供商。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für VPNs mit geteiltem Tunnel. Diese Abfragen verlassen den VPN-Tunnel und gehen an deine ausgewählten DNS-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les VPN à tunnel fractionné. Ces requêtes sortent du tunnel VPN et sont envoyées aux fournisseurs DNS sélectionnés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para VPN de túnel dividido. Estas consultas salen del túnel VPN y se envían a los proveedores de DNS que hayas seleccionado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 터널 VPN에서만 적용돼요. 이 요청은 VPN 터널을 벗어나 선택한 DNS 공급자로 전송돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para VPNs de túnel dividido. Essas consultas saem do túnel VPN e vão para os provedores de DNS selecionados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per VPN con tunnel suddiviso. Queste richieste escono dal tunnel VPN e raggiungono i provider DNS selezionati."
          }
        }
      }
    },
