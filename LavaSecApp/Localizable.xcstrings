    "This removes saved network activity entries from this device. Filtering counts and domain history are unchanged.": {
      "comment": "Release app UI string. Keep placeholders and product names intact. Generic device wording; retain precise service, permission and Keychain names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt gespeicherte Netzwerkaktivität von diesem Gerät. Filterzähler und Domainverlauf bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved network activity entries from this device. Filtering counts and domain history are unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les entrées d’activité réseau enregistrées sur cet appareil. Les compteurs de filtrage et l’historique des domaines ne changent pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されたネットワークアクティビティの記録を削除します。フィルタリング件数とドメイン履歴は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此设备移除已保存的网络活动记录。筛选计数和域名历史记录不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從這台裝置移除已儲存的網路活動項目。篩選計數與網域記錄不會變動。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina las entradas de actividad de red guardadas en este dispositivo. Los recuentos de filtrado y el historial de dominios no cambian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 네트워크 활동 항목을 삭제해요. 필터링 횟수와 도메인 기록은 그대로예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove os registros de atividade de rede salvos deste dispositivo. As contagens de filtragem e o histórico de domínios continuam os mesmos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove le voci dell’attività di rete salvate da questo dispositivo. I conteggi del filtraggio e la cronologia dei domini restano invariati."
          }
        }
      }
    },
    "Unlock this device and reopen Lava to read its security settings.": {
      "comment": "Security gate defaults, credential availability and foreground acknowledgement. Generic device wording; retain precise service, permission and Keychain names.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this device and reopen Lava to read its security settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre dieses Gerät und öffne Lava erneut, um die Sicherheitseinstellungen zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea este dispositivo y vuelve a abrir Lava para leer sus ajustes de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
