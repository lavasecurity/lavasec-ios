    "The import could not be saved or restored. Review the current filter before trying again.": {
      "comment": "User-visible: replaceFilterWithImportedShareableConfiguration .failure → ImportFiltersFlow applyError → alert Text(applyError.lavaLocalized) | AppViewModel+ShareableFilters.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import couldn’t be saved or restored. Review your active filter before trying again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import konnte weder gespeichert noch wiederhergestellt werden. Prüfe deinen aktiven Filter, bevor du es erneut versuchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar ni restaurar la importación. Revisa tu filtro activo antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer ou de restaurer l’importation. Vérifiez votre filtre actif avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
