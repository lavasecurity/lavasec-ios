    },
    "Send allowed DNS requests through your VPN. Changes reconnect Guard when it is on.": {
      "comment": "VPN chaining helper. Allowed means DNS requests not blocked by the filter; changing this setting reconnects active Guard protection.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende erlaubte DNS-Anfragen über dein VPN. Änderungen verbinden den Schutz neu, wenn er eingeschaltet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send allowed DNS requests through your VPN. Changes reconnect protection when it’s on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía las solicitudes DNS permitidas a través de tu VPN. Los cambios reconectan la protección si está activada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez les requêtes DNS autorisées via votre VPN. Les modifications reconnectent la protection lorsqu’elle est activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia le richieste DNS consentite tramite la tua VPN. Le modifiche riconnettono la protezione quando è attivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されたDNSリクエストをお使いのVPN経由で送信します。変更すると、保護がオンの場合は再接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용된 DNS 요청을 VPN을 통해 보내요. 보호가 켜져 있으면 변경 시 다시 연결돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie as solicitações DNS permitidas pela sua VPN. As alterações reconectam a proteção quando ela está ativada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的 VPN 发送已允许的 DNS 请求。防护开启时，更改会使其重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過你的 VPN 傳送已允許的 DNS 請求。防護開啟時，變更會使其重新連線。"
          }
        }
      }
    },
    "Check who shared this filter and review its contents carefully before importing. Shared filters aren’t reviewed by Lava.": {
      "comment": "Shared native helper or action. Filter means a saved filtering configuration; Focus refers to the system Focus feature. Keep Lava and VPN product terminology.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, wer diesen Filter geteilt hat, und sieh dir seinen Inhalt vor dem Import sorgfältig an. Geteilte Filter werden nicht von Lava geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check who shared this filter and review its contents carefully before importing. Shared filters aren’t reviewed by Lava."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba quién ha compartido este filtro y revisa su contenido con atención antes de importarlo. Lava no revisa los filtros compartidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez qui a partagé ce filtre et examinez attentivement son contenu avant de l’importer. Les filtres partagés ne sont pas vérifiés par Lava."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla chi ha condiviso questo filtro ed esaminane attentamente il contenuto prima di importarlo. I filtri condivisi non vengono verificati da Lava."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィルターの共有元を確認し、インポート前に内容をよく確認してください。共有フィルターはLavaによる審査を受けていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필터를 공유한 사람을 확인하고 가져오기 전에 내용을 주의 깊게 검토하세요. 공유된 필터는 Lava의 검토를 거치지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira quem compartilhou este filtro e revise o conteúdo com cuidado antes de importar. Os filtros compartilhados não são revisados pelo Lava."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入前，请确认此筛选器的分享者并仔细检查其内容。分享的筛选器未经 Lava 审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入前，請確認此篩選器的分享者並仔細檢查其內容。分享的篩選器未經 Lava 審核。"
          }
        }
      }
    },
