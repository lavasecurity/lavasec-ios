      }
    },
    "This passkey can't be used for zero-knowledge backup. Use a passkey provider that supports PRF (iCloud Keychain on iOS 18+), or set up without Passkey and keep your recovery phrase.": {
      "comment": "User-visible: BackupPasskeyError → BackupSetupView error text / restore panel | BackupPasskeyCoordinator.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This passkey can’t be used for zero-knowledge backup. Use a passkey provider that supports PRF (iCloud Keychain on iOS 18+), or set up without a passkey and keep your recovery phrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Passkey kann nicht für ein Zero-Knowledge-Backup verwendet werden. Verwende einen Passkey-Anbieter, der PRF unterstützt (iCloud-Schlüsselbund ab iOS 18), oder richte das Backup ohne Passkey ein und bewahre deine Wiederherstellungsphrase auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta llave de acceso no se puede usar para una copia de seguridad de conocimiento cero. Usa un proveedor de llaves de acceso compatible con PRF (Llavero de iCloud en iOS 18 o posterior), o configura la copia sin llave de acceso y conserva tu frase de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé d’accès ne peut pas être utilisée pour une sauvegarde zero-knowledge. Utilisez un gestionnaire de clés d’accès compatible PRF (trousseau iCloud sur iOS 18 ou version ultérieure), ou configurez sans clé d’accès et conservez votre phrase de récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa passkey non può essere usata per il backup a conoscenza zero. Usa un provider di passkey che supporti PRF (Portachiavi iCloud su iOS 18 o versioni successive) oppure configura senza passkey e conserva la frase di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスキーはゼロ知識バックアップに使用できません。PRFに対応したパスキープロバイダー（iOS 18以降のiCloudキーチェーン）を使うか、パスキーなしで設定してリカバリーフレーズを保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패스키는 영지식 백업에 사용할 수 없어요. PRF를 지원하는 패스키 제공자(iOS 18 이상의 iCloud 키체인)를 사용하거나, 패스키 없이 설정하고 복구 문구를 보관하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta passkey não pode ser usada para o backup de conhecimento zero. Use um provedor de passkeys compatível com PRF (Chaves do iCloud no iOS 18 ou posterior) ou configure sem passkey e guarde sua frase de recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此通行密钥无法用于零知识备份。请使用支持 PRF 的通行密钥提供方（如 iOS 18 或更高版本上的 iCloud 钥匙串），或不使用通行密钥进行设置，并保存好你的恢复短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個通行密鑰無法用於零知識備份。請使用支援 PRF 的通行密鑰提供者（例如 iOS 18 以上版本的 iCloud 鑰匙圈），或不使用通行密鑰進行設定，並妥善保存你的復原片語。"
          }
        }
      }
    },
