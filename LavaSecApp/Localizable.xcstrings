          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のアプリと保護のイベントが含まれます。DNSリクエストは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 앱 및 보호 이벤트가 포함돼요. DNS 요청은 포함되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso inclui eventos recentes do app e da proteção. Não inclui as solicitações de DNS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这包含最近的 App 与防护事件，但不包含 DNS 请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
