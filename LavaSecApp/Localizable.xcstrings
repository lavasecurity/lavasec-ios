      }
    },
    "Lava can't confirm whether protection is active.": {
      "comment": "Guard status detail. Keep terminology consistent with the Guard title and action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava can’t confirm whether protection is active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava kann nicht bestätigen, ob der Schutz aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava ne peut pas confirmer si la protection est active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava は保護が有効かどうかを確認できません。"
