    "Your entries and notes will be removed. The puzzle will stay the same.": {
      "comment": "Release app UI string. Keep product/legal terms from the glossary unchanged and review before final release.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einträge und Notizen werden entfernt. Das Rätsel bleibt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entries and notes will be removed. The puzzle will stay the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tus entradas y notas. El rompecabezas seguirá siendo el mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos saisies et vos notes seront supprimées. La grille restera la même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi inserimenti e le tue note verranno rimossi. Il puzzle resterà lo stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した数字とメモが削除されます。パズルは同じままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 숫자와 메모가 삭제됩니다. 퍼즐은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas entradas e anotações serão removidas. O quebra-cabeça continuará o mesmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你输入的数字和笔记将被移除。谜题将保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你輸入的數字和筆記將被移除。謎題將保持不變。"
          }
        }
      }
    },
