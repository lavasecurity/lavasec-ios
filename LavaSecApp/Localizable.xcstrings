        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請解鎖這台裝置並重新開啟 Lava，以讀取安全設定。"
          }
        }
      }
    },
    "Use public source URLs without private parameters before sharing.": {
      "comment": "Filter import limit, sharing URL privacy, or discard confirmation. %@ is a preformatted count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use public blocklist URLs without private parameters before sharing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有前に、非公開のパラメーターを含まない、公開されているブロックリストのURLを使用してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享前，請使用不含私人參數的公開封鎖清單網址。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享前，请使用不含私密参数的公开拦截列表网址。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende vor dem Teilen öffentliche Blocklisten-URLs ohne private Parameter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de partager, utilisez des URL de listes de blocage publiques sans paramètres privés."
