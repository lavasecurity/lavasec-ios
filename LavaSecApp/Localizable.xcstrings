    "Your VPN carries allowed DNS requests.": {
      "comment": "React Native v2 interface. Preserve placeholders and product names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your VPN carries allowed DNS requests."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein VPN leitet erlaubte DNS-Anfragen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu VPN lleva las solicitudes DNS permitidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre VPN achemine les requêtes DNS autorisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
