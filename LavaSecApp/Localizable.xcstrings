    "The order determines which VPN your traffic uses and when it uses both.": {
      "extractionState": "manual",
      "comment": "Quiet explanation below the VPN routing toggle. Keep concise and avoid technical terminology.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge bestimmt, welches VPN dein Datenverkehr nutzt und wann er beide nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order determines which VPN your traffic uses and when it uses both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden determina qué VPN usa tu tráfico y cuándo usa ambas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre détermine quel VPN utilise votre trafic et quand il passe par les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordine determina quale VPN usa il tuo traffico e quando le usa entrambe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "順序によって、通信に使うVPNと、両方を使う場合が決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순서에 따라 트래픽이 사용할 VPN과 두 VPN을 모두 사용할 경우가 결정됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ordem determina qual VPN seu tráfego usa e quando usa ambas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排列顺序决定流量使用哪个 VPN，以及何时同时使用两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排列順序決定流量使用哪個 VPN，以及何時同時使用兩者。"
          }
        }
      }
    },
    "DNS fallback is unavailable with an active full-tunnel VPN.": {
      "comment": "VPN chaining: shared settings and secret editor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS fallback is unavailable with an active full-tunnel VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルトンネルVPNが有効な間、DNSフォールバックは利用できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用完整通道 VPN 時，無法使用 DNS 備援。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用全隧道 VPN 时，无法使用 DNS 备用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-Fallback ist bei aktivem Volltunnel-VPN nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le DNS de secours est indisponible avec un VPN en tunnel complet actif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El DNS de respaldo no está disponible con una VPN de túnel completo activa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 터널 VPN이 활성화된 동안 DNS 대체 기능을 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DNS alternativo fica indisponível com uma VPN de túnel completo ativa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il DNS di riserva non è disponibile con una VPN a tunnel completo attiva."
          }
        }
      }
    },
