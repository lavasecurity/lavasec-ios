    "Thank you, Lava will look into this": {
      "comment": "Feedback confirmation title shown after a report is submitted without a follow-up email.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Lava sieht sich das an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks. Lava will look into this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Lava va examiner ce problème."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。Lavaが確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢。Lava 会跟进处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝。Lava 會查看這個問題。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Lava lo revisará."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사해요. Lava가 살펴볼게요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. O Lava vai analisar isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Lava esaminerà la cosa."
          }
        }
      }
    },
    "Thank you, Lava will look into this and reach out if needed": {
      "comment": "Feedback confirmation title shown after a report is submitted with a follow-up email.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Lava sieht sich das an und meldet sich bei Bedarf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks. Lava will look into this and follow up if needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Lava va examiner ce problème et vous recontactera si besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。Lavaが確認し、必要に応じてご連絡します。"
