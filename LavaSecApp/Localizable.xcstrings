          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende deinen Passkey noch einmal, damit Lava bestätigen kann, dass er dieses Backup entsperrt, und sichere dann deine Wiederherstellungsphrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
