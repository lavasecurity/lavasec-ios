    "Lava checks website names against your filter on this device.": {
      "comment": "Explore local filtering explanation for phones and tablets. Website names are checked on this device before DNS resolves addresses.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava checks website names against your filter on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava prüft Websitenamen auf diesem Gerät anhand deines Filters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava compara los nombres de los sitios con tu filtro en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava compare les noms de sites à votre filtre sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava confronta i nomi dei siti con il tuo filtro su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavaはこのデバイス上で、サイト名をフィルターと照らし合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava는 이 기기에서 사이트 이름을 필터로 확인해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lava compara os nomes dos sites com seu filtro neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava 会在此设备上用你的筛选器检查网站名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava 會在這台裝置上用你的篩選器檢查網站名稱。"
