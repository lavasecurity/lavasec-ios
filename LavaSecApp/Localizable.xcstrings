    "If iOS asks to add a VPN configuration, tap Allow.": {
      "comment": "vpnPermissionPromptMessage static let (AppViewModel:733), surfaced as vpnMessage -> guardPanelMessage -> Text(message.lavaLocalized) at GuardView:110. Catalog-only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iOS asks to add a VPN configuration, tap Allow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn iOS dich bittet, eine VPN-Konfiguration hinzuzufügen, tippe auf „Erlauben“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si iOS pide añadir una configuración de VPN, toca Permitir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si iOS vous demande d’ajouter une configuration VPN, touchez Autoriser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se iOS chiede di aggiungere una configurazione VPN, tocca Consenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがVPN構成の追加を求めてきたら、「許可」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 VPN 구성 추가를 요청하면 '허용'을 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o iOS pedir para adicionar uma configuração de VPN, toque em Permitir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 iOS 请求添加 VPN 配置，请轻点“允许”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 iOS 要求加入 VPN 設定，請點選「允許」。"
          }
        }
      }
    },
    "If your DNS provider keeps failing, Lava temporarily uses Device DNS for allowed requests, then switches back when it can.": {
      "comment": "Detail under the 'Fallback to Device DNS' toggle (iOS 26+).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your DNS provider keeps failing, Lava temporarily uses Device DNS for allowed requests, then switches back when it can."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein DNS-Anbieter wiederholt ausfällt, nutzt Lava vorübergehend das Geräte-DNS für erlaubte Anfragen und wechselt zurück, sobald es geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu proveedor de DNS falla repetidamente, Lava usa temporalmente el DNS del dispositivo para las solicitudes permitidas y vuelve en cuanto puede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre fournisseur DNS échoue à répétition, Lava utilise temporairement le DNS de l’appareil pour les requêtes autorisées, puis revient dès que possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo provider DNS continua a non rispondere, Lava usa temporaneamente il DNS del dispositivo per le richieste consentite e torna appena può."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したDNSプロバイダーが繰り返し失敗すると、Lavaは許可されたリクエストに一時的にデバイスのDNSを使い、可能になり次第戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 공급자가 계속 실패하면 Lava는 허용된 요청에 기기 DNS를 잠시 사용하고, 가능해지면 다시 전환해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu provedor de DNS falha várias vezes, o Lava usa o DNS do dispositivo temporariamente para as solicitações permitidas e volta assim que dá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果所选 DNS 提供商反复出问题，Lava 会临时用设备 DNS 处理放行的请求，并在可行时切回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果所選 DNS 供應商一再出問題，Lava 會暫時用裝置 DNS 處理允許的請求，並在可行時切回。"
          }
        }
      }
    },
    "If your DNS provider keeps failing, Lava temporarily uses Device DNS for allowed requests, then switches back when it can. On iOS 17–25 this is best effort.": {
      "comment": "Detail under the 'Fallback to Device DNS' toggle (iOS 17-25 variant).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your DNS provider keeps failing, Lava temporarily uses Device DNS for allowed requests, then switches back when it can. On iOS 17–25, this may not always work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein DNS-Anbieter wiederholt ausfällt, nutzt Lava vorübergehend das Geräte-DNS für erlaubte Anfragen und wechselt zurück, sobald es geht. Unter iOS 17–25 funktioniert das möglicherweise nicht immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu proveedor de DNS falla repetidamente, Lava usa temporalmente el DNS del dispositivo para las solicitudes permitidas y vuelve en cuanto puede. En iOS 17–25, puede que no siempre funcione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre fournisseur DNS échoue à répétition, Lava utilise temporairement le DNS de l’appareil pour les requêtes autorisées, puis revient dès que possible. Sur iOS 17–25, cela peut ne pas toujours fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo provider DNS continua a non rispondere, Lava usa temporaneamente il DNS del dispositivo per le richieste consentite e torna appena può. Su iOS 17–25 potrebbe non funzionare sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したDNSプロバイダーが繰り返し失敗すると、Lavaは許可されたリクエストに一時的にデバイスのDNSを使い、可能になり次第戻します。iOS 17–25では常に動作するとは限りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 공급자가 계속 실패하면 Lava는 허용된 요청에 기기 DNS를 잠시 사용하고, 가능해지면 다시 전환해요. iOS 17–25에서는 항상 작동하지 않을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu provedor de DNS falha várias vezes, o Lava usa o DNS do dispositivo temporariamente para as solicitações permitidas e volta assim que dá. No iOS 17–25, pode não funcionar sempre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 DNS 提供商反复出问题，Lava 会临时使用设备 DNS 处理已允许的请求，并在可行时切回。在 iOS 17–25 上，这可能并非始终有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 DNS 供應商一再出問題，Lava 會暫時用裝置 DNS 處理已允許的請求，並在可行時切回。在 iOS 17–25 上，這不一定總是有效。"
          }
        }
      }
    },
    "If your device's DNS stops responding, Lava sends allowed requests to a backup DNS provider, then switches back automatically.": {
      "comment": "Detail under the 'Fallback to alternative DNS' toggle (Device-DNS primary).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Device DNS stops responding, Lava sends allowed requests to your fallback DNS provider, then switches back automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Geräte-DNS nicht mehr reagiert, sendet Lava erlaubte Anfragen an deinen Ersatz-DNS-Anbieter und wechselt dann automatisch zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el DNS del dispositivo deja de responder, Lava envía las solicitudes permitidas a tu proveedor de DNS de respaldo y luego vuelve automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le DNS de l’appareil ne répond plus, Lava envoie les requêtes autorisées à votre fournisseur DNS de secours, puis revient automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il DNS del dispositivo smette di rispondere, Lava invia le richieste consentite al tuo provider DNS di riserva e poi torna indietro automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのDNSが応答しなくなると、Lavaは許可されたリクエストをフォールバックDNSプロバイダーに送り、その後自動で元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 DNS가 응답하지 않으면 Lava는 허용된 요청을 대체 DNS 공급자로 보내고, 이후 자동으로 되돌아가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o DNS do dispositivo parar de responder, o Lava envia as solicitações permitidas para o seu provedor de DNS alternativo e depois volta automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果设备 DNS 停止响应，Lava 会把已允许的请求发送到你的备用 DNS 提供商，随后自动切回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果裝置 DNS 停止回應，Lava 會把已允許的請求送往你的備援 DNS 供應商，之後自動切回。"
          }
        }
      }
    },
