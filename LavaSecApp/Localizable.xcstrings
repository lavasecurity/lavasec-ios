    "This removes saved allowed, blocked, and local protection uptime counts from this device.": {
      "comment": "User-visible: bridge confirmations → RN Alert.alert() (presentation.tsx localizes title/message by exact key) — Privacy/Activity \"Clear …\" confirmations | PrivacySecuritySettingsView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved allowed, blocked, and protection uptime counts from this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die gespeicherten Zähler für erlaubte und blockierte Anfragen sowie die Schutz-Laufzeit von diesem Gerät entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de este dispositivo los recuentos guardados de elementos permitidos, bloqueados y de tiempo de protección activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime de cet appareil les compteurs enregistrés des requêtes autorisées, des requêtes bloquées et de la durée de protection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione rimuove da questo dispositivo i conteggi salvati di elementi consentiti, bloccati e di tempo di attività della protezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された許可・ブロックの件数と保護の稼働時間をこのデバイスから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 허용·차단 횟수와 보호 작동 시간이 이 기기에서 삭제돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove deste dispositivo as contagens salvas de permitidos, bloqueados e tempo de proteção ativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从此设备移除已保存的允许、拦截和防护运行时长计数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從這台裝置移除已儲存的允許、封鎖及防護運作時間計數。"
          }
        }
      }
    },
    "This removes saved domain rows from this device. Filtering counts and network activity are unchanged.": {
      "comment": "User-visible: bridge confirmations → RN Alert.alert() (presentation.tsx localizes title/message by exact key) — Privacy/Activity \"Clear …\" confirmations | PrivacySecuritySettingsView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes saved domain history from this device. Filtering counts and network activity are unchanged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt den gespeicherten Domainverlauf von diesem Gerät. Filterzähler und Netzwerkaktivität bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el historial de dominios guardado en este dispositivo. Los recuentos de filtrado y la actividad de red no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l’historique des domaines enregistré sur cet appareil. Les compteurs de filtrage et l’activité réseau ne changent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove la cronologia dei domini salvata da questo dispositivo. I conteggi del filtraggio e l’attività di rete restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されたドメイン履歴を削除します。フィルタリング件数とネットワークアクティビティは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 도메인 기록이 이 기기에서 삭제돼요. 필터링 횟수와 네트워크 활동은 그대로예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o histórico de domínios salvo deste dispositivo. As contagens de filtragem e a atividade de rede continuam as mesmas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
