    "Added: %1$lld blocklists, %2$lld blocked domains, %3$lld custom sources, %4$lld allowed exceptions.": {
      "comment": "Contextual filter import, sharing, or rename. Preserve filter names and numbered count placeholders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added: %1$lld blocklists, %2$lld blocked domains, %3$lld custom blocklists, %4$lld allowed exceptions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt: %1$lld Blocklisten, %2$lld blockierte Domains, %3$lld eigene Blocklisten, %4$lld erlaubte Ausnahmen."
          }
        },
        "es": {
          "stringUnit": {
