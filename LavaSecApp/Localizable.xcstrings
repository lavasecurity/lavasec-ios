    "Online backup deleted. Local backup cleanup could not finish. Try turning off backup again.": {
      "comment": "September feedback: settings, backup, DNS or Plus. Preserve the distinction between local setup and confirmed online upload.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
