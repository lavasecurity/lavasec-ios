    "Your draft library changes won't be applied.": {
      "comment": "Filter import limit, sharing URL privacy, or discard confirmation. %@ is a preformatted count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your draft library changes won’t be applied."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルター一覧の下書き変更は適用されません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會套用篩選器庫的草稿變更。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会应用筛选器库的草稿更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliotheksentwürfe werden nicht angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications en cours de la bibliothèque ne seront pas appliquées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aplicarán los cambios pendientes de la biblioteca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리의 임시 변경 사항은 적용되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
