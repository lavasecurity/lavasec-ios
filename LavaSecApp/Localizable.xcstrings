    "A DNS check failed. Lava is retrying.": {
      "comment": "Protection status subtitle under the \"Reconnecting\" title: an automatic DNS health check failed and Lava keeps retrying on its own; filtering stays active and no user action is needed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A DNS check failed. Lava is retrying."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine DNS-Prüfung ist fehlgeschlagen. Lava versucht es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha fallado una comprobación de DNS. Lava lo está reintentando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vérification DNS a échoué. Lava réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un controllo DNS non è riuscito. Lava sta riprovando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS チェックに失敗しました。Lava が再試行しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 확인에 실패했어요. Lava가 다시 시도하고 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação de DNS falhou. A Lava está tentando novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 检查未通过。Lava 正在自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一項 DNS 檢查失敗。Lava 正在自動重試。"
          }
        }
      }
    },
    "A Lava a day keeps bad domains away.": {
      "comment": "GuardianShieldStyle.settingsDescription .original (SettingsView:2110); shown as Guard-look subtitle when revealed, SettingsView:1976. Catalog-only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Lava a day keeps bad domains away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lava am Tag hält schädliche Domains fern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Lava al día aleja los dominios maliciosos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Lava par jour éloigne les domaines malveillants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Lava al giorno toglie i domini cattivi di torno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日1Lavaで、危険なドメインを寄せつけない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한 번 Lava면 나쁜 도메인은 멀리."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Lava por dia mantém os domínios ruins bem longe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天一点 Lava，恶意域名远离你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天用 Lava，惡意網域遠離你。"
          }
        }
