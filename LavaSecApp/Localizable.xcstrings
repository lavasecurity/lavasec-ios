    "The first configuration's MTU must be at least 1340 for two VPN hops.": {
      "comment": "WireGuard chain validation and recovery.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first configuration's MTU must be at least 1340 for two VPN hops."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNを2段接続するには、1つ目の構成のMTUが1340以上である必要があります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
