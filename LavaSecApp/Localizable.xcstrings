          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre clé d’accès une nouvelle fois pour que Lava confirme qu’elle déverrouille cette sauvegarde, puis enregistrez votre phrase de récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
