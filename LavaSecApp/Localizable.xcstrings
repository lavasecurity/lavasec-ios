    "The remaining configuration will become the only VPN hop. Guard reconnects if chaining is on.": {
      "comment": "VPN chaining: shared settings and secret editor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remaining configuration will become the only VPN hop. Guard reconnects if chaining is on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残った構成が唯一のVPNホップになります。チェーンがオンの場合、保護は再接続します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘設定將成為唯一的 VPN 節點。若已啟用串接，Guard 會重新連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余配置将成为唯一的 VPN 节点。如果已启用串联，Guard 会重新连接。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verbleibende Konfiguration wird zum einzigen VPN-Hop. Bei aktivierter Verkettung verbindet sich Guard neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration restante sera le seul relais VPN. Guard se reconnecte si le chaînage est activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración restante será el único salto VPN. Guard se reconecta si el encadenamiento está activado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 구성이 유일한 VPN 홉이 돼요. VPN 체이닝이 켜져 있으면 보호가 다시 연결돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração restante será o único salto VPN. O Guard reconecta se o encadeamento estiver ativo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione rimanente sarà l’unico passaggio VPN. Guard si riconnette se il concatenamento è attivo."
          }
        }
      }
    },
    "This deletes its saved keys and turns VPN chaining off.": {
      "comment": "VPN chaining: shared settings and secret editor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes its saved keys and turns VPN chaining off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された鍵を削除し、VPNチェーンをオフにします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除已儲存的金鑰並關閉 VPN 串接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
