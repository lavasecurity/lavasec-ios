            "state": "translated",
            "value": "スキャンしてインポート — Lava の入手もこちら"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔해서 가져오기 — 또는 Lava 먼저 받기"
