{
  "sourceLanguage": "en",
  "strings": {
    "%@ list wasn’t imported because it’s no longer available.": {
      "comment": "Shared filter import checks current catalog availability. %@ is the number of skipped lists when present. Existing installations are retained.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Liste wurde nicht importiert, da sie nicht mehr verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ list wasn’t imported because it’s no longer available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liste n’a pas été importée, car elle n’est plus disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@件のリストは提供が終了したため、インポートされませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个列表已不再提供，因此未导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個清單已不再提供，因此未匯入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se importó %@ lista porque ya no está disponible."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 목록은 더 이상 제공되지 않아 가져오지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lista não foi importada porque não está mais disponível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lista non è stata importata perché non è più disponibile."
          }
        }
      }
    },
