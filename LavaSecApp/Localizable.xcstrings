    "If your usual DNS stops answering, Lava can use an encrypted fallback.": {
      "comment": "Onboarding v2 interface. Keep product names and networking terms consistent with the existing catalog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your usual DNS stops answering, Lava can use an encrypted fallback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein übliches DNS nicht mehr antwortet, kann Lava ein verschlüsseltes Ersatz-DNS nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu DNS habitual deja de responder, Lava puede usar un DNS de respaldo cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre DNS habituel ne répond plus, Lava peut utiliser un DNS de secours chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo DNS abituale non risponde più, Lava può usare un DNS di riserva cifrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもの DNS が応答しなくなった場合、Lava は暗号化フォールバックを利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 사용하는 DNS가 응답하지 않으면 Lava가 암호화된 대체 DNS를 사용할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o DNS que você usa parar de responder, o Lava pode usar um DNS alternativo criptografado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果常用的 DNS 停止响应，Lava 可以改用加密的备用 DNS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果平常使用的 DNS 停止回應，Lava 可以使用加密備援。"
          }
        }
      }
    },
