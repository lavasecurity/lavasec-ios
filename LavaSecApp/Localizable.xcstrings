    "This helps debug missing, stale, or incorrectly compiled filter lists.": {
      "comment": "Bug-report preview section title/purpose (BugReportBundle, shown via .lavaLocalized).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This helps debug missing, stale, or incorrectly compiled blocklists."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hilft, fehlende, veraltete oder falsch kompilierte Blocklisten zu untersuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ayuda a depurar listas de bloqueo faltantes, obsoletas o mal compiladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela aide à diagnostiquer des listes de blocage manquantes, obsolètes ou mal compilées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta a individuare liste di blocco mancanti, obsolete o compilate in modo errato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不足・古い・正しくコンパイルされていないブロックリストの調査に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누락되었거나 오래되었거나 잘못 컴파일된 차단 목록을 진단하는 데 도움이 돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso ajuda a depurar listas de bloqueio ausentes, desatualizadas ou compiladas incorretamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
