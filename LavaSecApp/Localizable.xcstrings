    "Backup deletion could not be saved safely. Try again.": {
      "comment": "Backup deletion fence: preserve retryable account ownership and unavailable secure-storage distinctions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup deletion couldn’t be saved safely. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの削除状態を安全に保存できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全儲存備份刪除狀態。請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存备份删除状态。请重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Backup-Löschung konnte nicht sicher gespeichert werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de la sauvegarde n’a pas pu être enregistrée de manière sûre. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar de forma segura la eliminación de la copia de seguridad. Inténtalo de nuevo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 삭제 상태를 안전하게 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a exclusão do backup com segurança. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare l’eliminazione del backup in modo sicuro. Riprova."
          }
        }
      }
    },
    "Backup deletion is pending. Sign in to the original account and try turning off backup again.": {
      "comment": "Backup deletion fence: preserve retryable account ownership and unavailable secure-storage distinctions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup deletion is pending. Sign in to the original account and try turning off backup again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの削除が保留中です。元のアカウントにサインインして、もう一度バックアップをオフにしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份刪除尚未完成。請登入原本的帳號，然後再次嘗試關閉備份。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份删除尚未完成。请登录原来的账户，然后再次尝试关闭备份。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung des Backups steht noch aus. Melde dich beim ursprünglichen Konto an und versuche erneut, das Backup auszuschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de la sauvegarde est en attente. Connectez-vous au compte d’origine et réessayez de désactiver la sauvegarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación de la copia de seguridad está pendiente. Inicia sesión en la cuenta original e intenta desactivar la copia de seguridad de nuevo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 삭제가 보류 중입니다. 원래 계정에 로그인한 후 백업 끄기를 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
