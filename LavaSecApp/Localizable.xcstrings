    "New? Install, finish setup, then scan again.": {
      "comment": "Share card: explains the two-scan flow to a recipient who does not have Lava yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu? Installieren, Einrichtung abschließen, dann erneut scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New? Install, finish setup, then scan again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Nuevo? Instala, completa la configuración y vuelve a escanear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveau ? Installez, terminez la configuration, puis rescannez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuovo? Installa, completa la configurazione, poi scansiona di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめて？ インストールし、設定を終えてからもう一度スキャン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음이신가요? 설치하고 설정을 마친 뒤 다시 스캔하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novo? Instale, conclua a configuração e leia de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初次使用？先安装、完成设置，然后再扫一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初次使用？先安裝、完成設定，然後再掃一次。"
          }
        }
      }
    },
    "This filter is too large for an image QR. Copy the setup code instead.": {
      "comment": "Accessibility hint on the disabled share-card button when the full link cannot be encoded as a QR at any correction level.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
