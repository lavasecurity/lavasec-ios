      }
    },
    "Looks like you shook your device. Want to tell us what went wrong?": {
      "comment": "Message in the rage-shake feedback dialog, shown after the user shakes the device.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht aus, als hättest du dein Gerät geschüttelt. Möchtest du uns sagen, was nicht funktioniert hat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like you shook your device. Want to tell us what went wrong?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dirait que vous avez secoué votre appareil. Voulez-vous nous dire ce qui n’a pas fonctionné ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを振ったようです。うまくいかなかった点を教えてもらえますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看起来你摇了摇设备。想告诉我们哪里出问题了吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看來你搖了一下裝置。想告訴我們哪裡出了問題嗎？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que has agitado el dispositivo. ¿Quieres contarnos qué ha pasado?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 흔드신 것 같아요. 어떤 점이 불편했는지 알려주실래요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você balançou o dispositivo. Quer nos contar o que deu errado?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che tu abbia scosso il dispositivo. Vuoi dirci cosa non ha funzionato?"
          }
        }
      }
    },
    "Malicious domains are the hot spots. Your device can step around them before apps and websites connect.": {
      "comment": "Release app UI string. Keep placeholders and product names intact. Generic device wording; retain precise service, permission and Keychain names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schädliche Domains sind die Gefahrenstellen. Dein Gerät kann ihnen ausweichen, bevor Apps und Websites eine Verbindung aufbauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Malicious domains are the hot spots. Your device can step around them before apps and websites connect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les domaines malveillants, c’est là que ça chauffe. Votre appareil peut les éviter avant que les apps et les sites s’y connectent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪意のあるドメインは危険の集まる場所です。アプリやサイトが接続する前に、デバイスがそこを避けてくれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恶意域名就像滚烫的岩浆。在 App 和网站连接前，你的设备可以先帮你绕开它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "惡意網域就像滾燙的熱點。在 App 與網站連線前，你的裝置可以先繞開它們。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dominios dañinos son los puntos calientes. Tu dispositivo puede esquivarlos antes de que las apps y los sitios web se conecten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해로운 도메인은 피해야 할 곳이에요. 앱과 사이트가 연결되기 전에 기기가 알아서 피해 갈 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os domínios nocivos são os pontos a evitar. O seu dispositivo pode desviar deles antes que apps e sites se conectem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I domini dannosi sono i punti caldi. Il tuo dispositivo può aggirarli prima che app e siti web si colleghino."
          }
        }
      }
    },
