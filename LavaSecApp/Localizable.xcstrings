    "Help Lava work with your network. Choose the profile in iOS Settings after setup. The orange dots show you where to go.": {
      "comment": "Onboarding setup. Preserve product names.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Lava work with your network. Choose the profile in iOS Settings after setup. The orange dots show you where to go."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava がネットワークで動作するようサポートします。セットアップ後、iOS の設定でプロファイルを選択してください。オレンジ色の点が手順を案内します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf Lava, mit deinem Netzwerk zu arbeiten. Wähle nach der Einrichtung das Profil in den iOS-Einstellungen aus. Die orangefarbenen Punkte zeigen dir den Weg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez Lava à fonctionner avec votre réseau. Après la configuration, sélectionnez le profil dans les réglages iOS. Les points orange vous indiquent où aller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Lava a funcionar con tu red. Tras la configuración, selecciona el perfil en los ajustes de iOS. Los puntos naranjas te indican dónde ir."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lava가 네트워크에서 작동하도록 도와주세요. 설정을 마친 후 iOS 설정에서 프로파일을 선택하세요. 주황색 점이 안내해 드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude o Lava a funcionar com sua rede. Após a configuração, selecione o perfil nos Ajustes do iOS. Os pontos laranja indicam o caminho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta Lava a funzionare con la tua rete. Dopo la configurazione, seleziona il profilo nelle impostazioni di iOS. I punti arancioni ti indicano dove andare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助 Lava 在你的网络上运行。完成设置后，请在 iOS 设置中选择描述文件。橙色圆点会指引你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "協助 Lava 在你的網路上運作。完成設定後，請在 iOS 設定中選擇描述檔。橘色圓點會指引你。"
          }
        }
      }
    },
