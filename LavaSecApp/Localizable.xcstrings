            "value": "削除すると、これらのフィルターとカスタム変更が削除されます。初期設定に戻すと、元のフィルターが再作成されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除會移除這些篩選器及其自訂變更。還原預設值會重建原始篩選器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除会移除这些筛选器及其自定义更改。恢复默认值会重新创建原始筛选器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen werden diese Filter samt Anpassungen entfernt. Das Wiederherstellen der Standardwerte erstellt die ursprünglichen Filter neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression retire ces filtres et leurs modifications. Rétablir les réglages par défaut recrée les filtres d’origine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminarlos se borran estos filtros y sus cambios. Restaurar los valores predeterminados recrea los filtros originales."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하면 필터와 사용자 변경 사항이 제거됩니다. 기본값 복원은 원래 필터를 다시 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão remove estes filtros e suas alterações. Restaurar os padrões recria os filtros originais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione rimuove questi filtri e le modifiche personalizzate. Il ripristino dei valori predefiniti ricrea i filtri originali."
          }
        }
      }
    },
