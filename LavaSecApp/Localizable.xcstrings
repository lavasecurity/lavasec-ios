    "Device DNS identifies the DNS resolver supplied by the current Wi-Fi, cellular, or system network configuration.": {
      "comment": "App-authored display copy from shared native presentation models. Preserve provider names and dynamic values.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device DNS identifies the DNS resolver supplied by the current Wi-Fi, cellular, or system network configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスDNSは、現在のWi-Fi、モバイル通信、またはシステムのネットワーク設定から提供されるDNSリゾルバーを示します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置 DNS 指目前 Wi-Fi、行動網路或系統網路設定提供的 DNS 解析器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备 DNS 指当前 Wi-Fi、移动网络或系统网络设置提供的 DNS 解析器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte-DNS bezeichnet den DNS-Resolver der aktuellen WLAN-, Mobilfunk- oder Systemnetzwerkkonfiguration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le DNS de l’appareil désigne le résolveur DNS fourni par la configuration actuelle du Wi-Fi, du réseau mobile ou du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El DNS del dispositivo identifica el resolutor DNS de la configuración actual de Wi-Fi, red móvil o sistema."
