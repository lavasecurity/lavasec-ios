          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝。Lava 會查看，需要時會再與你聯絡。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Lava lo revisará y se pondrá en contacto si es necesario."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사해요. Lava가 살펴보고 필요하면 연락드릴게요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
