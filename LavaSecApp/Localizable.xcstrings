    "Adds ads and trackers. May break some sites.": {
      "comment": "Onboarding protection-level summary for the Comprehensive level.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds ads and trackers. May break some websites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänzt Werbung und Tracker. Kann manche Websites beeinträchtigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade anuncios y rastreadores. Puede afectar a algunos sitios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les pubs et les traqueurs. Peut perturber certains sites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge pubblicità e tracker. Potrebbe compromettere alcuni siti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告とトラッカーを追加でブロックします。一部のサイトが正しく表示されないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고와 추적기를 추가해요. 일부 사이트가 제대로 작동하지 않을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona anúncios e rastreadores. Pode prejudicar alguns sites."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加对广告和跟踪器的拦截。可能导致部分网站无法正常使用。"
