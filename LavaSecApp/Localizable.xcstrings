    },
    "Try a backup DNS service when websites won't load. The default is Quad9": {
      "comment": "Onboarding connection options: conversational heading or quiet explanation outside its toggle card. Preserve service and Apple feature names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a backup DNS service when websites won't load. The default is Quad9"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトを開けないときに予備のDNSサービスを使います。標準はQuad9です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Ladeproblemen einen Ersatz-DNS-Dienst nutzen. Standard ist Quad9."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un service DNS de secours si les sites ne chargent pas. Par défaut : Quad9."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba un servicio DNS de respaldo si los sitios no cargan. El predeterminado es Quad9."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트가 열리지 않으면 백업 DNS 서비스를 사용해요. 기본값은 Quad9예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um serviço DNS de reserva se os sites não carregarem. O padrão é o Quad9."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un servizio DNS di riserva se i siti non si caricano. Il servizio predefinito è Quad9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站无法加载时尝试备用 DNS 服务。默认为 Quad9。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網站無法載入時嘗試備援 DNS 服務。預設為 Quad9。"
          }
        }
      }
    },
    "This helps Lava work well in iOS 27 with Connectivity Assist. Follow the orange dots for complete setups": {
      "comment": "Onboarding connection options: conversational heading or quiet explanation outside its toggle card. Preserve service and Apple feature names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This helps Lava work well in iOS 27 with Connectivity Assist. Follow the orange dots for complete setups"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27のConnectivity AssistでLavaが快適に動作するようにします。オレンジの点をたどって設定を完了してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft Lava, unter iOS 27 mit Connectivity Assist gut zu funktionieren. Folge den orangefarbenen Punkten, um die Einrichtung abzuschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide Lava à bien fonctionner avec Connectivity Assist sous iOS 27. Suivez les points orange pour terminer la configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Lava a funcionar bien en iOS 27 con Connectivity Assist. Sigue los puntos naranjas para completar la configuración."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27의 연결 지원에서 Lava가 잘 작동하도록 도와줘요. 주황색 점을 따라 설정을 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda o Lava a funcionar bem no iOS 27 com Connectivity Assist. Siga os pontos laranja para concluir a configuração."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta Lava a funzionare bene su iOS 27 con Connectivity Assist. Segui i punti arancioni per completare la configurazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助 Lava 在 iOS 27 中配合 Connectivity Assist 顺畅运行。跟随橙色圆点完成设置。"
