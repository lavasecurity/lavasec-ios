          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hilft, Fehler nachzuvollziehen, die mit einem bestimmten App-Build, einer iOS-Version oder einer Gerätefamilie zusammenhängen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ayuda a reproducir errores ligados a una versión concreta de la app, de iOS o a una familia de dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci aide à reproduire les bugs liés à une version précise de l’app, d’iOS ou à une famille d’appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta a riprodurre i bug legati a una specifica build dell’app, versione di iOS o famiglia di dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の App ビルド、iOS バージョン、デバイスの種類に関連する不具合の再現に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 앱 빌드, iOS 버전 또는 기기 종류와 관련된 버그를 재현하는 데 도움이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso ajuda a reproduzir bugs ligados a uma versão específica do app, do iOS ou a uma família de dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这有助于复现与特定 App 版本、iOS 版本或设备类型相关的错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這有助於重現與特定 App 版本、iOS 版本或裝置類型相關的錯誤。"
          }
        }
      }
    },
    "This includes recent app, VPN, and tunnel handling events. It does not include DNS requests.": {
      "comment": "Bug-report preview section purpose: Tunnel Lifecycle Log.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This includes recent app and protection events. It does not include DNS requests."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das umfasst aktuelle App- und Schutzereignisse. DNS-Anfragen sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto incluye eventos recientes de la app y de la protección. No incluye solicitudes de DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci inclut les événements récents liés à l’app et à la protection. Cela n’inclut pas les requêtes DNS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
