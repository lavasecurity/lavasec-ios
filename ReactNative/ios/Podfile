require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, '18.0'
project 'LavaSecUIReview', 'Debug' => :debug, 'Release' => :release, 'QAReview' => :release
prepare_react_native_project!

# This workspace contains only the review app. Production/extension projects are
# never opened or mutated by CocoaPods. The two native navigation dependencies are pinned and checked.
target 'LavaSecUIReview' do
  pod 'RNScreens', :path => '../node_modules/react-native-screens'
  pod 'RNSVG', :path => '../node_modules/react-native-svg'
  pod 'react-native-safe-area-context', :path => '../node_modules/react-native-safe-area-context'
  use_react_native!(
    :path => '../node_modules/react-native',
    :app_path => File.expand_path('..', __dir__),
    :config_file_dir => File.expand_path('..', __dir__)
  )
  post_install do |installer|
    react_native_post_install(installer, '../node_modules/react-native', :mac_catalyst_enabled => false)
    installer.pods_project.targets.select { |target| target.name.start_with?('RNSVG') }.each do |target|
      target.build_configurations.each { |config| config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0' }
    end
  end
end
