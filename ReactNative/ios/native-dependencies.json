  "scripts": [
    {
      "project": "ios/LavaSecUIReview.xcodeproj",
      "target": "LavaSecUIReview",
      "name": "[CP] Check Pods Manifest.lock",
      "shell": "/bin/sh",
      "body": "diff \"${PODS_PODFILE_DIR_PATH}/Podfile.lock\" \"${PODS_ROOT}/Manifest.lock\" > /dev/null\nif [ $? != 0 ] ; then\n    # print error to STDERR\n    echo \"error: The sandbox is not in sync with the Podfile.lock. Run 'pod install' or update your CocoaPods installation.\" >&2\n    exit 1\nfi\n# This output is used by Xcode 'outputs' to avoid re-running this script phase.\necho \"SUCCESS\" > \"${SCRIPT_OUTPUT_FILE_0}\"\n"
    },
    {
      "project": "ios/LavaSecUIReview.xcodeproj",
      "target": "LavaSecUIReview",
      "name": "[CP] Embed Pods Frameworks",
      "shell": "/bin/sh",
      "body": "\"${PODS_ROOT}/Target Support Files/Pods-LavaSecUIReview/Pods-LavaSecUIReview-frameworks.sh\"\n"
    },
    {
      "project": "ios/LavaSecUIReview.xcodeproj",
      "target": "LavaSecUIReview",
      "name": "[CP] Copy Pods Resources",
      "shell": "/bin/sh",
      "body": "\"${PODS_ROOT}/Target Support Files/Pods-LavaSecUIReview/Pods-LavaSecUIReview-resources.sh\"\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "React-Core-prebuilt",
      "name": "[CP-User] [RNCore] Replace React Native Core for the right configuration, if needed",
      "shell": "/bin/sh",
      "body": "      . \"$REACT_NATIVE_PATH/scripts/xcode/with-environment.sh\"\n\n      CONFIG=\"Release\"\n      if echo $GCC_PREPROCESSOR_DEFINITIONS | grep -q \"DEBUG=1\"; then\n        CONFIG=\"Debug\"\n      fi\n\n      \"$NODE_BINARY\" \"$REACT_NATIVE_PATH/scripts/replace-rncore-version.js\" -c \"$CONFIG\" -r \"0.87.1\" -p \"$PODS_ROOT\"\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "React-Core-prebuilt",
      "name": "[CP] Copy XCFrameworks",
      "shell": "/bin/sh",
      "body": "\"${PODS_ROOT}/Target Support Files/React-Core-prebuilt/React-Core-prebuilt-xcframeworks.sh\"\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "React-RCTFBReactNativeSpec",
      "name": "[CP-User] [RN]Check FBReactNativeSpec",
      "shell": "/bin/sh",
      "body": "echo \"Checking whether Codegen has run...\"\nfbReactNativeSpecPath=\"$REACT_NATIVE_PATH/React/FBReactNativeSpec\"\n\nif [[ ! -d \"$fbReactNativeSpecPath\" ]]; then\n  echo 'error: Codegen did not run properly in your project. Please reinstall cocoapods with `bundle exec pod install`.'\n  exit 1\nfi\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "ReactCodegen",
      "name": "[CP-User] Generate Specs",
      "shell": "/bin/sh",
      "body": "if [ -n \"$PODFILE_DIR\" ]; then\n  RCT_SCRIPT_POD_INSTALLATION_ROOT=\"$PODFILE_DIR\"\nelse\n  pushd \"$PODS_ROOT/../\" > /dev/null\n  RCT_SCRIPT_POD_INSTALLATION_ROOT=$(pwd)\n  popd >/dev/null\nfi\n\nexport RCT_SCRIPT_RN_DIR=\"$RCT_SCRIPT_POD_INSTALLATION_ROOT/../node_modules/react-native\"\nexport RCT_SCRIPT_APP_PATH=\"$RCT_SCRIPT_POD_INSTALLATION_ROOT/..\"\nexport RCT_SCRIPT_OUTPUT_DIR=\"$RCT_SCRIPT_POD_INSTALLATION_ROOT\"\nexport RCT_SCRIPT_TYPE=\"withCodegenDiscovery\"\n\nexport SCRIPT_PHASES_SCRIPT=\"$RCT_SCRIPT_RN_DIR/scripts/react_native_pods_utils/script_phases.sh\"\nexport WITH_ENVIRONMENT=\"$RCT_SCRIPT_RN_DIR/scripts/xcode/with-environment.sh\"\n/bin/sh -c '\"$WITH_ENVIRONMENT\" \"$SCRIPT_PHASES_SCRIPT\"'\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "ReactNativeDependencies",
      "name": "[CP-User] [RNDeps] Replace React Native Dependencies for the right configuration, if needed",
      "shell": "/bin/sh",
      "body": "      . \"$REACT_NATIVE_PATH/scripts/xcode/with-environment.sh\"\n\n      CONFIG=\"Release\"\n      if echo $GCC_PREPROCESSOR_DEFINITIONS | grep -q \"DEBUG=1\"; then\n        CONFIG=\"Debug\"\n      fi\n\n      \"$NODE_BINARY\" \"$REACT_NATIVE_PATH/third-party-podspecs/replace_dependencies_version.js\" -c \"$CONFIG\" -r \"0.87.1\" -p \"$PODS_ROOT\"\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "ReactNativeDependencies",
      "name": "[CP] Copy XCFrameworks",
      "shell": "/bin/sh",
      "body": "\"${PODS_ROOT}/Target Support Files/ReactNativeDependencies/ReactNativeDependencies-xcframeworks.sh\"\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "hermes-engine",
      "name": "[CP-User] [Hermes] Replace Hermes for the right configuration, if needed",
      "shell": "/bin/sh",
      "body": "        . \"$REACT_NATIVE_PATH/scripts/xcode/with-environment.sh\"\n\n        CONFIG=\"Release\"\n        if echo $GCC_PREPROCESSOR_DEFINITIONS | grep -q \"DEBUG=1\"; then\n          CONFIG=\"Debug\"\n        fi\n\n        \"$NODE_BINARY\" \"$REACT_NATIVE_PATH/sdks/hermes-engine/utils/replace_hermes_version.js\" -c \"$CONFIG\" -r \"250829098.0.17\" -p \"$PODS_ROOT\"\n"
    },
    {
      "project": "ios/Pods/Pods.xcodeproj",
      "target": "hermes-engine",
      "name": "[CP] Copy XCFrameworks",
      "shell": "/bin/sh",
      "body": "\"${PODS_ROOT}/Target Support Files/hermes-engine/hermes-engine-xcframeworks.sh\"\n"
    }
  ],
