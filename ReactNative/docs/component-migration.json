  "additiveEntryPoints": [
    "src/ui/contracts/adapter.ts",
    "src/ui/contracts/navigation.ts",
    "src/ui/components/choice.tsx"
  ],
  "retainedPlatformOwners": [
    "src/components.ios.tsx",
    "src/choice.ios.tsx",
    "src/toggle-row.ios.tsx",
    "src/surface.ios.tsx",
    "src/colors.ios.ts",
    "src/foundation.ts",
    "src/generated/tokens.ts",
    "src/GuardianDrawing.tsx",
    "src/OnboardingDrawing.tsx",
    "specs/"
  ],
  "adopterMigration": "Toolbar consumers use toolbarAction with the same labels, callbacks, identifiers and exact iOS glyphs. Other existing component consumers retain their imports and component identities.",
  "androidIntegration": "Apply only structural delta; reconcile existing overlays and canonical-source provenance in the Android repository."
}
