      "owner": "src/ui/contracts/toggle.ts",
      "exports": [
        "LavaToggleRowProps"
      ],
      "compatibilityEntry": "src/contracts.ts",
      "android": "shared"
    },
    {
      "family": "choice-contract",
      "previousOwner": "src/contracts.ts",
      "owner": "src/ui/contracts/choice.ts",
      "exports": [
        "LavaChoiceProps",
        "LavaChoiceOption"
      ],
      "compatibilityEntry": "src/contracts.ts",
      "android": "shared"
    },
    {
      "family": "toggle-request",
      "previousOwner": "src/toggle-row.ios.tsx",
      "owner": "src/ui/behavior/toggle.ts",
      "exports": [
        "useToggleRequest"
