    },
    {
      "family": "ios-symbols",
      "previousOwner": "src/components.ios.tsx",
      "owner": "src/ui/platform/ios/icons.ts",
      "exports": [
        "actionSymbols"
      ],
      "compatibilityEntry": "src/components.ios.tsx",
      "android": "platform binding required"
    },
    {
      "family": "ios-toolbar",
      "previousOwner": "review/scaffold.tsx",
      "owner": "src/ui/platform/toolbar.ios.ts",
      "exports": [
        "toolbarButton",
        "toolbarToggle",
        "ToolbarSymbol"
      ],
      "compatibilityEntry": "review/scaffold.tsx",
