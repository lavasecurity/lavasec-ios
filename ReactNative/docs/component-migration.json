{
  "scope": "RN component foundation; existing renderers, native wires, tokens, artwork and feature owners retained",
  "components": [
    {
      "family": "text",
      "previousOwner": "src/contracts.ts",
      "owner": "src/ui/contracts/text.ts",
      "exports": [
        "LavaTextProps",
        "LavaTextRole",
        "LavaTextTone"
      ],
      "compatibilityEntry": "src/contracts.ts",
      "android": "shared"
    },
    {
      "family": "surface",
      "previousOwner": "src/contracts.ts",
      "owner": "src/ui/contracts/surface.ts",
      "exports": [
        "LavaCardProps"
      ],
      "compatibilityEntry": "src/contracts.ts",
      "android": "shared"
    },
    {
      "family": "actions",
      "previousOwner": "src/contracts.ts",
      "owner": "src/ui/contracts/action.ts",
      "exports": [
        "LavaActionButtonProps"
      ],
      "compatibilityEntry": "src/contracts.ts",
      "android": "shared"
    },
    {
      "family": "icons",
      "previousOwner": "src/contracts.ts",
      "owner": "src/ui/contracts/icon.ts",
      "exports": [
        "LavaIconAction",
        "LavaIconButtonProps"
      ],
      "compatibilityEntry": "src/contracts.ts",
      "android": "shared"
    },
    {
      "family": "selection",
      "previousOwner": "src/contracts.ts",
      "owner": "src/ui/contracts/selection.ts",
      "exports": [
        "LavaSelectionAccessoryProps"
      ],
      "compatibilityEntry": "src/contracts.ts",
