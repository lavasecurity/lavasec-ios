/* Resolver and protection-scope disclosure (P0: resolver-and-protection-scope-disclosure plan, Task 1). */
"core.disclosure.resolver" = "Lavas Sperrentscheidungen werden auf diesem iPhone getroffen. Der von dir gewählte Resolver, derzeit %@, kann zugelassene DNS-Anfragen empfangen; sie unterliegen dann dessen Richtlinie.";
"core.disclosure.resolverNetworkProvided" = "Lavas Sperrentscheidungen werden auf diesem iPhone getroffen. Die DNS-Server, die dieses iPhone aus einem WLAN, dem Mobilfunknetz oder den Systemeinstellungen übernommen hat, können zugelassene DNS-Anfragen empfangen. Ein Lava-Server nie.";
"core.disclosure.resolverSelfEntered" = "Lavas Sperrentscheidungen werden auf diesem iPhone getroffen. Das von dir eingerichtete eigene DNS kann zugelassene DNS-Anfragen empfangen.";
"core.disclosure.dnsScope" = "Lava prüft Domainnamen, keine vollständigen URLs, Seitenpfade, Seitentexte, Formulare oder Nachrichten. Lava kann eine ganze Domain sperren, aber keine einzelne Seite auf einer zugelassenen Domain.";
"core.disclosure.vpn" = "Das iPhone nennt dies ein VPN, weil Lava einen lokal geschützten Pfad benötigt, um Domainnamen zu prüfen. Dein Surf-Datenverkehr wird nicht an Lava-Server gesendet.";
"core.disclosure.encryptedFallbackRecipient" = "Das von dir gewählte verschlüsselte Ersatz-DNS (%@) kann ebenfalls erlaubte DNS-Anfragen erhalten.";
"core.disclosure.chainedRecipient" = "Während Lava mit einem anderen VPN verkettet ist, können die DNS-Server aus der Konfiguration dieses VPNs zugelassene DNS-Anfragen als Erste empfangen. Lava kann nicht sagen, wer sie betreibt.";
"core.disclosure.fallbackNetworkProvided" = "Auch die DNS-Server, die dieses iPhone aus dem Netzwerk übernommen hat, können zugelassene DNS-Anfragen empfangen.";
"core.disclosure.plainFallbackRecipient" = "Das von dir gewählte Ersatz-DNS (%@) kann ebenfalls erlaubte DNS-Anfragen erhalten. Es ist nicht verschlüsselt.";
"core.disclosure.upstreamFilteringRecipient" = "%@ filtert selbst und kann daher eine Domain sperren, die Lava zugelassen hat.";
"core.disclosure.selfEnteredRecipients" = "Du hast diese DNS-Server selbst eingetragen, daher kann Lava nicht sagen, wer sie betreibt. Jede von dir eingetragene Adresse kann zugelassene DNS-Anfragen empfangen.";
"core.disclosure.selfEnteredRecipient" = "Du hast diesen DNS-Server selbst eingetragen, daher kann Lava nicht sagen, wer ihn betreibt.";

